# ---------- 模型（任何 OpenAI 兼容接口都行） ----------
# DeepSeek: https://api.deepseek.com  /  deepseek-chat
# OpenAI:   https://api.openai.com/v1  /  gpt-4o-mini
# 本地:     http://127.0.0.1:11434/v1  /  qwen2.5
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=1024

# ---------- 上下文 ----------
# 超过这个估算 token 数就把旧对话压缩成备忘
CONTEXT_TOKEN_LIMIT=2000
# 压缩后保留最近几条原文（建议 4~6，必须是偶数更整齐）
KEEP_RECENT_MESSAGES=4

# ---------- 存储 ----------
DB_PATH=data/chatbot.db

# ---------- 提示词文件 ----------
SYSTEM_PROMPT_FILE=prompts/system.md
HANDBOOK_FILE=prompts/handbook.md

# ---------- 品牌文案（改成你的机器人，页面自动生效） ----------
BOT_NAME=小雀
BOT_EMOJI=☕
BOT_TAGLINE=云雀咖啡 · 在线客服
PAGE_TITLE=小雀 · 云雀咖啡在线客服
WELCOME_TITLE=今天想喝点什么？
WELCOME_SUB=营业时间、配送范围、会员卡、退换货，都可以问我。
INPUT_HINT=输入你的问题…
# 用 | 分隔，最多 4 条
EXAMPLE_QUESTIONS=你们几点开门？|外卖多久能送到？|会员卡怎么办？|咖啡太苦能换一杯吗？
BOT_ACCENT=#b4622d
BOT_ACCENT_SOFT=#f7e7d8
STORAGE_KEY=chatbot.session
